{
	"addonRoot": true,
	"library": ["Clicked/Libs/"],
	"diagnostics": {
		"enable": [
			"need-check-nil",
			"nil-index",
			"implicit-nil-return",
			"invalid-op",
			"incomplete-signature-doc",
			"missing-param-annotation",
			"missing-return-annotation",
			"unknown-param-type",
			"unknown-return-type",
			"unknown-field-type",
			"unknown-local-type"
		],
		"severity": {
			"incomplete-signature-doc": "warning",
			"unknown-local-type": "warning",
			"unknown-param-type": "warning",
			"unknown-return-type": "warning",
			"unknown-field-type": "warning",
			"unused-local": "warning",
			"shadowed-local": "warning",
			"missing-param-annotation": "warning",
			"implicit-nil-return": "error",
			"inject-field": "error"
		}
	},
	"globals": {
		"read": ["ElvUI", "ElvUISpellBookTooltip", "LibStub"],
		"write": ["Clicked", "ClickedMedia", "Clique", "ClickCastHeader", "ClickCastFrames"]
	}
}
