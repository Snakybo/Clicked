{
	"addonRoot": true,
	"library": ["Clicked/Libs/"],
	"diagnostics": {
		"enable": [
			"need-check-nil",
			"nil-index",
			"invalid-op",
			"unknown-callback-event",
			"unused-local",
			"unused-function",
			"unused-vararg",
			"incomplete-signature-doc",
			"missing-param-annotation",
			"missing-return-annotation",
			"redundant-or",
			"redundant-and",
			"redundant-condition",
			"implicit-nil-return",
			"unknown-param-type",
			"unknown-return-type",
			"unknown-local-type",
			"unknown-field-type"
		],
		"severity": {
			"access-private": "error",
			"access-protected": "error",
			"assign-type-mismatch": "error",
			"cannot-call": "error",
			"circle-doc-class": "error",
			"count-down-loop": "error",
			"create-global": "error",
			"duplicate-index": "error",
			"field-type-mismatch": "error",
			"grouped-return-mismatch": "error",
			"implicit-nil-return": "error",
			"inject-field": "error",
			"invalid-class-parent": "error",
			"invalid-op": "error",
			"malformed-annotation": "error",
			"missing-parameter": "error",
			"missing-return": "error",
			"missing-return-value": "error",
			"need-check-nil": "error",
			"not-precedence": "error",
			"redundant-parameter": "error",
			"redundant-return-value": "error",
			"return-mismatch": "error",
			"secret-access": "error",
			"secret-argument": "error",
			"secret-arithmetic": "error",
			"secret-comparison": "error",
			"secret-condition": "error",
			"secret-table-key": "error",
			"type-mismatch": "error",
			"undefined-doc-class": "error",
			"undefined-doc-name": "error",
			"undefined-doc-param": "error",
			"undefined-field": "error",
			"undefined-global": "error",
			"unknown-cast-variable": "error",
			"code-after-break": "warning",
			"empty-block": "warning",
			"incomplete-signature-doc": "warning",
			"missing-param-annotation": "warning",
			"missing-return-annotation": "warning",
			"redundant-return": "warning",
			"return-self-class-name": "warning",
			"shadowed-local": "warning",
			"unknown-field-type": "warning",
			"unknown-local-type": "warning",
			"unknown-param-type": "warning",
			"unknown-return-type": "warning",
			"unreachable-code": "warning",
			"unused-local": "warning",
			"unused-vararg": "warning"
		}
	},
	"globals": {
		"read": ["ElvUI", "ElvUISpellBookTooltip", "LibStub"],
		"write": ["Clicked", "ClickedMedia", "Clique", "ClickCastHeader", "ClickCastFrames"]
	}
}
